include submit.sh
recursive-include scripts *.py
recursive-include docs *.md
recursive-include examples *.py *.ipynb
include configurations/*.yaml configurations/*.md
prune configurations/outputs
prune configurations/opacity_cache
prune configurations/scratch
prune configurations/retrievals
